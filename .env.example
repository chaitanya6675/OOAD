# ==========================================
# SMART E-COMMERCE ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=production

# JSON Web Token Secret (generate a secure random 32+ character string in production)
JWT_SECRET=your_jwt_secret_key_here

# Central Database Storage Path
DATABASE_PATH=./database/ecommerce.db

# Frontend Client URL (for CORS allowance)
CLIENT_URL=http://localhost:5173
